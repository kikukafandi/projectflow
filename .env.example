# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Object storage (Vercel Blob) — added in a later phase
# STORAGE_TOKEN=""

# Intake lead dari website KreaByte (/api/intake/lead).
# Isi nilai yang SAMA PERSIS dengan PROJECTFLOW_INTAKE_SECRET di KreaByte.
# Kosong = endpoint menolak semua permintaan (gagal-tertutup).
INTAKE_SECRET=""

# Email yang boleh "Hapus paksa" (klien/proyek beserta semua turunannya).
# Dipisah koma. Kosong = tombol hapus paksa tidak muncul untuk siapa pun.
ADMIN_EMAILS="admin@gmail.com"
